<script>

/* ===== CURSOR ===== */

const cursor = document.querySelector(".cursor");

document.addEventListener("mousemove",(e)=>{
    cursor.style.left = e.clientX + "px";
    cursor.style.top = e.clientY + "px";
});


/* ===== SCROLL REVEAL ===== */

const reveals = document.querySelectorAll(".reveal");

function reveal(){

    reveals.forEach(element => {

        const windowHeight =
            window.innerHeight;

        const elementTop =
            element.getBoundingClientRect().top;

        if(elementTop < windowHeight - 100){
            element.classList.add("active");
        }

    });

}

window.addEventListener("scroll",reveal);

reveal();


/* ===== BOOKING ===== */

document.getElementById("booking")
.addEventListener("submit",async function(e){

    e.preventDefault();

    const formData = new FormData(this);
    const reservation = {
        id: crypto.randomUUID ? crypto.randomUUID() : Date.now().toString(),
        name: formData.get("name"),
        phone: formData.get("phone"),
        date: formData.get("date"),
        guests: formData.get("guests"),
        createdAt: new Date().toISOString()
    };

    // Send to the backend when available.
    try {
        const response = await fetch("/api/reservations", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(reservation)
        });
        if (!response.ok) throw new Error("Storage request failed");
    } catch (error) {
        // Temporary browser storage keeps bookings when the API is offline.
        const saved = JSON.parse(
            localStorage.getItem("shivxx_reservations") || "[]"
        );
        saved.push(reservation);
        localStorage.setItem("shivxx_reservations", JSON.stringify(saved));
    }

    alert(
        "🔥 SHIVXX\n\n" +
        "Your reservation request has been received."
    );

    this.reset();

});


/* ===== PARALLAX ===== */

document.addEventListener("mousemove",(e)=>{

    const plate =
        document.querySelector(".plate");

    let x =
        (window.innerWidth/2 - e.clientX) / 40;

    let y =
        (window.innerHeight/2 - e.clientY) / 40;

    plate.style.marginLeft = x + "px";
    plate.style.marginTop = y + "px";

});

</script>

</body>
